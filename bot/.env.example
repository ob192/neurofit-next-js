# Copy to bot/.env and fill in. Never commit the real file.

# From @BotFather → /newbot (or /token for an existing bot).
TELEGRAM_BOT_TOKEN=

# The studio's group chat. Add the bot to the group as an administrator with
# "Manage topics", then send /id in the group and paste the number it replies
# with. It is negative and, for a supergroup, starts with -100.
TELEGRAM_GROUP_CHAT_ID=

# Where the client→topic mapping is kept. Leave this UNSET when running the
# Docker image — it already points at /data/state.json, which is the volume.
# Setting it here would override that and put the file somewhere unwritable.
# For a bare `python -m app`, the default is data/state.json.
# BOT_STATE_FILE=data/state.json

# Postgres for the client→topic mapping. Strongly preferred in production: it
# survives a redeploy that forgets the volume, which the JSON file does not —
# and a forgotten mapping means a second topic for every existing client.
# Unset falls back to BOT_STATE_FILE.
DATABASE_URL=

# --- GA4 Measurement Protocol ---------------------------------------------
# Server-side conversions. Booking happens in this chat, so three of the four
# stages of a lead exist only here — the website can only see the click that
# started it. Optional: unset means the bot works exactly as before and sends
# nothing.
#
# The measurement id is the same G- one the website's GTM container reports to,
# and the API secret comes from GA4 Admin → Data Streams → the web stream →
# Measurement Protocol API secrets. It may be the same secret the website uses
# or a second one; GA4 allows several per stream.
#
# Attribution needs DATABASE_URL as well: the visitor's GA4 identity is on the
# click row the website wrote, and without it there is nothing to attach a
# conversion to.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Send to Google's validation endpoint and log its verdict instead of recording
# anything. The live endpoint answers 204 to malformed payloads exactly as it
# does to good ones, so this is the only way to know an event was accepted.
# Nothing is recorded while it is on.
# GA4_DEBUG=1
