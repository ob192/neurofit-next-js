# Secrets — never commit
.env
# GCP service-account key. Holds a private key; grant access to the service
# account in the GTM/GA4 UIs instead of sharing this file.
service-account.json
*-service-account.json
# Next's per-developer overrides. NEXT_PUBLIC_SITE_URL lives here locally; on a
# deploy it must come from the hosting platform's environment instead.
.env*.local

# Camera originals from the studio shoot (~375 MB of JPGs). The compressed
# WebP derivatives in web/public/images/gallery/ are what the site serves and
# what belongs in git; keep the masters in cloud storage, not in history.
studio-photos/

# Node
node_modules/
npm-debug.log*

# JetBrains IDE
.idea/
