# Copy to .env.local. Everything here is optional — the app runs with defaults.

# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# tags and the @id fields inside the JSON-LD graph. Without it those fall back
# to http://localhost:3000, which is fine for local development but must be set
# in production or search engines will index localhost URLs.
NEXT_PUBLIC_SITE_URL=https://neurofit.com.ua

# Altegio (alteg.io) live booking backend. OPTIONAL: when both are set the
# booking flow uses the studio's real calendar; when absent it falls back to the
# in-memory mock (src/lib/mock/), so local dev and CI work with no credentials.
# Both are server-only — do NOT add a NEXT_PUBLIC_ prefix.
#   ALTEGIO_PARTNER_TOKEN — partner token from the Altegio marketplace
#   ALTEGIO_LOCATION_ID   — company/location id (the number in the admin
#                           timetable URL: app.alteg.io/timetable/{id})
# ALTEGIO_PARTNER_TOKEN=
# ALTEGIO_LOCATION_ID=

# --- Telegram booking bot -------------------------------------------------
# The bot every "Записатися" CTA opens, without the leading @. Optional: the
# code falls back to the studio's own handle (neurofit_booking_bot). Public by
# nature — it is rendered into the page as a t.me link.
NEXT_PUBLIC_TELEGRAM_BOT=neurofit_booking_bot

# --- Analytics: GA4 Measurement Protocol ----------------------------------
# Server-side conversions. The site's own conversion happens in a Telegram chat
# the browser never sees, so `generate_lead` is sent from /go/tg rather than
# from a tag. Both are server-only — do NOT add a NEXT_PUBLIC_ prefix.
#
# GA4_MEASUREMENT_ID — the same G- id the GTM container already reports to.
#                      Also names the session cookie (_ga_<id without G->),
#                      which /go/tg reads, so a wrong value silently costs
#                      session attribution rather than failing.
# GA4_API_SECRET     — GA4 Admin → Data Streams → the web stream →
#                      Measurement Protocol API secrets → Create.
# Unset means no events are sent. The redirect still works.
GA4_MEASUREMENT_ID=G-DHQ8N6RZ39
GA4_API_SECRET=

# Set to 1 to send events to Google's validation endpoint instead of the live
# one and log what it says. The live endpoint answers 204 to malformed payloads
# too, so this is the only way to know an event was accepted. Never leave it on
# in production — nothing is recorded while it is.
# GA4_DEBUG=1

# --- Click log -------------------------------------------------------------
# The same Neon database the Telegram bot uses. /go/tg writes one row per click
# through to the bot; the bot reads it back by the id it passes in `/start`,
# which is what ties a booking to the ad that paid for it.
#
# The `clicks` table is created by the BOT at startup, not by the site — deploy
# the bot first. Unset, or a database without the table, degrades to plain
# t.me deep links with no logging and no server-side events.
DATABASE_URL=
