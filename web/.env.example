# Copy to .env.local. Everything here is optional — the app runs with defaults.

# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# tags and the @id fields inside the JSON-LD graph. Without it those fall back
# to http://localhost:3000, which is fine for local development but must be set
# in production or search engines will index localhost URLs.
NEXT_PUBLIC_SITE_URL=https://neurofit.com.ua

# No CRM / booking-provider credentials are needed: the booking API in this
# project is a self-contained in-memory mock (see src/lib/mock/).
